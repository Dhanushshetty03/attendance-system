# Environment Configuration for Logisys Smart Attendance System

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection
# SQLite (Local Development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production / Alternative)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/logisys_attendance?schema=public"

# Authentication Security
JWT_SECRET=your-secure-random-256-bit-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Institution Details & Policies
INSTITUTION_NAME="National Institute of Engineering & Technology"
ATTENDANCE_THRESHOLD=75
CRITICAL_THRESHOLD=65
